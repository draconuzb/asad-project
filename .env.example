# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
CEO_TELEGRAM_ID=your_ceo_telegram_id
MANAGER_ID=your_manager_telegram_id

# TWA (Telegram Web App)
TWA_PORT=8100
WEB_APP_URL=https://your-domain.com/twa/

# Database GUI (ns-webapp)
# Static token so it persists across PM2 restarts
# Generate with: node -e "console.log(require(crypto).randomBytes(32).toString(hex))"
GUI_AUTH_TOKEN=your_gui_auth_token_here

# Google Sheets sync (optional — leave empty to disable)
GOOGLE_SHEETS_ID=
